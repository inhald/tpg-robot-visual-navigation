Bootstrap: docker
From: ubuntu:22.04

%setup
	mkdir -p "$SINGULARITY_ROOTFS/project" \
		 "$SINGULARITY_ROOTFS/scratch" \
		 "$SINGULARITY_ROOTFS/cluster_home" \
		 "$SINGULARITY_ROOTFS/lustre03/project" \
		 "$SINGULARITY_ROOTFS/lustre04/scratch"

%environment
	export IGN_GAZEBO_RESOURCE_PATH=/opt/ros/humble/share:/usr/share/ignition:$IGN_GAZEBO_RESOURCE_PATH
	export GAZEBO_MODEL_PATH=/opt/ros/humble/share:$GAZEBO_MODEL_PATH
	export TPG=/home/teeluckn/projects/def-skelly/teeluckn/tpg
	export IGN_RENDER_ENGINE=ogre2
	export PATH=$PATH:$TPG/scripts/plot
	export PATH=$PATH:$TPG/scripts/run


%post
	set -e
	apt-get update && \
    	DEBIAN_FRONTEND=noninteractive apt-get install -y \
      		curl \
      		gnupg \
      		ca-certificates \
      		lsb-release
	curl -sSL \
      		https://packages.osrfoundation.org/gazebo.gpg \
      		-o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg	
	
	echo "deb [arch=$(dpkg --print-architecture) \
      		signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] \
      		http://packages.osrfoundation.org/gazebo/ubuntu-stable \
      		$(lsb_release -cs) main" \
      		> /etc/apt/sources.list.d/gazebo-stable.list

	########## ROS 2 Humble Repository ##########

	curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
  		| gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg

	echo "deb [arch=$(dpkg --print-architecture) \
  		signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
  		http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
  		> /etc/apt/sources.list.d/ros2-humble.list	
		
	apt-get update
	DEBIAN_FRONTEND=noninteractive apt-get install -y ignition-fortress

	######## Bulk Libraries #########

	DEBIAN_FRONTEND=noninteractive apt-get install -y \
		libboost-all-dev \
		scons libbz2-dev \
		libglu1-mesa-dev freeglut3-dev mesa-common-dev \
		xterm graphviz \
		libeigen3-dev libarmadillo-dev \
		r-base r-cran-catools r-cran-zoo \
		openmpi-bin libopenmpi-dev \
		git vim htop \
		libcurlpp-dev jq \
		libglfw3 libglfw3-dev libglew-dev \
		catch2 \
		ffmpeg libosmesa6-dev \
		valgrind bc poppler-utils \
		cmake python3-pandas python3-matplotlib python3-venv \
		pipx libyaml-cpp-dev lcov \
		libtbb2 libtbb-dev

	####### Additional Gazebo Libraries #####

	DEBIAN_FRONTEND=noninteractive apt-get install -y \
		libignition-gazebo6-plugins \
		libignition-gazebo6-dev \
		libsdformat13-dev \
		ros-humble-irobot-create-description \
		ros-humble-turtlebot4-description \
		libopencv-dev \
		libboost-mpi-dev

	
	###### Python Tooling ######

	pipx ensurepath || true





	apt-get clean
	rm -rf /var/lib/apt/lists/*


