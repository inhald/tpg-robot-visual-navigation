<?xml version="1.0"?>
<sdf version='1.8'>
    <world name='maze'>
      <physics name='1ms' type='ode'>
            <max_step_size>0.01</max_step_size>
	    <!--<real_time_factor>1</real_time_factor>-->
            <real_time_update_rate>0</real_time_update_rate>
      </physics>
	  <!---<physics name='fast' type='ode'>
	  <max_step_size>0.02</max_step_size>
	  <real_time_update_rate>0</real_time_update_rate>
	  <ode>
	    <solver>
	      <type>quick</type>
	      <iters>20</iters>
	      <sor>1.3</sor>
	    </solver>
	    <constraints>
	      <cfm>1e-3</cfm>
	      <erp>0.2</erp>
	      <contact_max_correcting_vel>10</contact_max_correcting_vel>
	      <contact_surface_layer>0.001</contact_surface_layer>
	    </constraints>
	  </ode>
	  </physics>-->

        <plugin name='ignition::gazebo::systems::Physics' filename='ignition-gazebo-physics-system' />
        <plugin name='ignition::gazebo::systems::UserCommands' filename='ignition-gazebo-user-commands-system' />
        <plugin name='ignition::gazebo::systems::SceneBroadcaster' filename='ignition-gazebo-scene-broadcaster-system' />
        <plugin name='ignition::gazebo::systems::Contact' filename='ignition-gazebo-contact-system' />


      <plugin name="ignition::gazebo::RandomizedSpawnerECS" filename="libRandomizedSpawner.so">
	<robot_name>turtlebot4</robot_name>
	<base_seed>42</base_seed>

	<!-- Existing sampling annuli -->
	<goal_r_min>0.4</goal_r_min>
	<goal_r_max>0.7</goal_r_max>

	<obs_r_min>0.5</obs_r_min>
	<obs_r_max>0.7</obs_r_max>

	<sample_about_robot>false</sample_about_robot>
	<sample_center_x>0.0</sample_center_x>
	<sample_center_y>0.0</sample_center_y>

	<!-- Footprints -->
	<target_half_width>0.10</target_half_width>
	<target_half_depth>0.10</target_half_depth>
	<target_aabb_height>0.40</target_aabb_height>

	<obs_size_x>0.40</obs_size_x>
	<obs_size_y>0.40</obs_size_y>
	<obs_size_z>0.75</obs_size_z>

	<!-- Separation between target and obstacle AABBs -->
	<extra_separation>0.08</extra_separation>

	<!-- New: rejection sampling limits -->
	<max_goal_tries>300</max_goal_tries>
	<max_obs_tries>300</max_obs_tries>

	<!-- New: wall robustness (prevents near-wall deadlocks) -->
	<wall_margin>0.05</wall_margin>

	<!-- New: if strict placement fails, retry with smaller separation -->
	<relax_on_fail>true</relax_on_fail>
	<relax_factor>0.5</relax_factor> <!-- new_sep = extra_separation * relax_factor -->

	<!-- New: if still fails, reuse last success (or safe default) instead of stalling -->
	<use_last_success_fallback>true</use_last_success_fallback>

	<!-- New: ignore these names when checking AABB collisions.
	     Add multiple tags, one per substring.
	     YOU SHOULD EDIT THESE to match your world model names. -->
	<ignore_name_contains>ground_plane</ignore_name_contains>
	<ignore_name_contains>floor</ignore_name_contains>
	<ignore_name_contains>sun</ignore_name_contains>
	<ignore_name_contains>light</ignore_name_contains>
	<ignore_name_contains>arena</ignore_name_contains>

	<!-- Existing (kept) -->
	<require_in_fov>false</require_in_fov>
	<hfov_deg>90</hfov_deg>

	<!-- Bounds -->
	<min_x>-5</min_x><max_x>5</max_x>
	<min_y>-5</min_y><max_y>5</max_y>

	<!-- NOTE: half_width/half_depth/aabb_height are unused by the rewritten sampler
	     for goal/obstacle; it uses target_half_* and obs_size_* directly.
	     You can keep them, but they don't affect placement anymore. -->
	<half_width>0.5</half_width>
	<half_depth>0.5</half_depth>
	<aabb_height>2.0</aabb_height>
      </plugin>



      <plugin name="ignition::gazebo::v6::systems::Sensors" filename="libignition-gazebo-sensors-system.so"/>

      <plugin name="path_length_plugin" filename="libPathLengthPlugin.so">
	<resolution>0.01</resolution>        <!-- m/cell -->
	<padding>1.0</padding>               <!-- expand X/Y bounds -->
	<static_only>true</static_only>      <!-- ignore moving objects (optional) -->
	<diag>true</diag>                    <!-- 8-connected grid -->
	<goal_topic>/random_pose_res</goal_topic>
	<result_topic>/path_length/optimal</result_topic>
      </plugin>


      <light name='sun' type='directional'>
            <cast_shadows>1</cast_shadows>
            <pose>0 0 10 0 -0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.90000000000000002</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
            <spot>
                <inner_angle>0</inner_angle>
                <outer_angle>0</outer_angle>
                <falloff>0</falloff>
            </spot>
      </light>
        <gravity>0 0 -9.8</gravity>
        <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
        <atmosphere type='adiabatic' />
        <scene>
            <ambient>0.4 0.4 0.4 1</ambient>
            <background>0.7 0.7 0.7 1</background>
            <shadows>0</shadows>
        </scene>
	<!-- added -->
	<plugin name="ignition::gazebo::systems::SceneBroadcaster" filename="libignition-gazebo-scene-broadcaster-system.so"/>
	<!-- added -->
	<model name='ground_plane'> 
            <static>1</static>
            <link name='link'>
                <collision name='collision'>
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <surface>
                        <friction>
                            <ode />
                        </friction>
                        <bounce />
                        <contact />
                    </surface>
                </collision>
                <visual name='visual'>
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                        <specular>0.8 0.8 0.8 1</specular>
                    </material>
                    <plugin name='__default__' filename='__default__' />
                </visual>
            </link>
            <plugin name='__default__' filename='__default__' />
            <pose>0 0 0 0 -0 0</pose>
        </model>

        <model name='border'>
            <pose>0 0 1 0 0 0</pose>
            <static>true</static>
            <link name='wall1'>
                <pose>-10.005 0 0 0 0 0</pose>
                <static>true</static>
                <collision name='wall1_collision'>
                    <geometry>
                        <box>
                            <size>0.01 20 2</size>
                        </box>
                    </geometry>
                </collision>
                <visual name='wall1_visual'>
                    <geometry>
                        <box>
                            <size>0.01 20 2</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.1 0.1 0.1 1</ambient>
                        <diffuse>0 0.01 0.05 1</diffuse>
                        <specular>0 0.01 0.05 1</specular>
                    </material>
                </visual>
            </link>
            <link name='wall2'>
                <pose>10.005 0 0 0 0 0</pose>
                <static>true</static>
                <collision name='wall2_collision'>
                    <geometry>
                        <box>
                            <size>0.01 20 2</size>
                        </box>
                    </geometry>
                </collision>
                <visual name='wall2_visual'>
